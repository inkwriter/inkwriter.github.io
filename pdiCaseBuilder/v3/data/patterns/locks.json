{
  "schema_version": "1.1",
  "pack_id": "locks",
  "privacy": "public_safe",
  "description": "Sanitized PDI troubleshooting patterns for locks.",
  "patterns": [
    {
      "id": "paperwork-lock",
      "name": "Paperwork / Process Lock",
      "category": "Locks",
      "summary": "Poll Day can be blocked by a real paperwork/process lock, including a hung DRE process.",
      "support_level": "strong",
      "safety": "read_only",
      "match_rules": [
        {
          "type": "choice_any",
          "step": "poll",
          "values": [
            "Lock / data error"
          ],
          "weight": 4
        },
        {
          "type": "text_any",
          "values": [
            "paperwork locked",
            "locked by dre",
            "lock in silk",
            "hung dre",
            "cannot poll day"
          ],
          "weight": 6
        },
        {
          "type": "field_equals",
          "field": "paperwork_lock_status",
          "value": "lock_reported",
          "weight": 7,
          "label": "A paperwork lock is reported"
        },
        {
          "type": "field_equals",
          "field": "paperwork_lock_status",
          "value": "owner_identified",
          "weight": 8,
          "label": "The lock owner/process is identified"
        }
      ],
      "strong_score": 6,
      "possible_score": 4,
      "next_safe_step": "Open SILK, identify the affected store/business date, and determine who or what owns the lock before clearing anything.",
      "why": "Historical cases show a lock may be caused by a user or by a hung process such as DRE.",
      "recommended_evidence": [
        "Exact lock message",
        "Lock owner/process",
        "Store/business date",
        "Lock start time"
      ],
      "guardrails": [
        "Red Skipped Close is not automatically a SILK lock.",
        "Resolve the legitimate owner/process before retrying Poll Day."
      ],
      "recommended_fields": [
        "paperwork_lock_status",
        "lock_owner"
      ]
    }
  ]
}